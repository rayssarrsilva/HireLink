{
  "name": "hirelinks",
  "version": "0.1.0",
  "description": "HireLinks: finds job links that match your skills and saves them in a spreadsheet FlashHire can read / coleta links de vagas compatíveis com você",
  "scripts": {
    "dev": "tsx src/server/index.ts --dev",
    "start": "vite build && tsx src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "author": "Rayssa Roberta Rodrigues Silva",
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "playwright": "^1.65.1",
    "unpdf": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
